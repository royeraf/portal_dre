APP_NAME="DRE Huánuco"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://drehuanuco.gob.pe
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://drehuanuco.gob.pe

OPENAI_API_KEY=
OPENAI_CHATBOT_MODEL=gpt-5.6-luna
OPENAI_CHATBOT_REASONING=medium
OPENAI_OCR=true
OPENAI_OCR_MODEL=gpt-5.6-luna
OPENAI_OCR_FILE_EXPIRY_SECONDS=3600
OPENAI_LIMITE_DIARIO_TOKENS=500000

CHATBOT_RETENTION_DAYS=90
CHATBOT_STORE_TRANSCRIPTS=true
CHATBOT_REDACT_PERSONAL_DATA=true
CHATBOT_AI_PROVIDER_NAME=OpenAI

CLAMAV_BINARY=/usr/bin/clamscan
CLAMAV_REQUIRED=true
CLAMAV_TIMEOUT_SECONDS=90
